{
  "name": "AWS lab webhook relay",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lab-relay",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Inbound (n8n webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "lab-relay"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "source",
              "value": "n8n",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "event",
              "value": "={{ $json.body.event ?? 'relay' }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "item",
              "value": "={{ $json.body.item ?? '' }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "status",
              "value": "={{ $json.body.status ?? '' }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "relayed_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Build payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-API-ID.execute-api.us-east-2.amazonaws.com/lab/webhook",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "POST to AWS Lambda webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "AWS lab webhook key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ relay: 'ok', aws: $json }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Respond with AWS ack",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Inbound (n8n webhook)": {
      "main": [
        [
          {
            "node": "Build payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build payload": {
      "main": [
        [
          {
            "node": "POST to AWS Lambda webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST to AWS Lambda webhook": {
      "main": [
        [
          {
            "node": "Respond with AWS ack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
